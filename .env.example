# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_MODEL: Gemini model identifier (supports structured output)
GEMINI_MODEL="gemini-3.8-flash"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"
# DATABASE CONFIGURATION:
# Optional universal PostgreSQL connection URL (e.g., Cloud SQL, Supabase, Neon, RDS, or local PG).
# If not set, ClaritySQL automatically initializes and runs embedded PostgreSQL with disk persistence.
DATABASE_URL=""

# SYSTEM LIMITS & TIMEOUTS:
MAX_CSV_BYTES=26214400
MAX_CSV_ROWS=100000
MAX_CSV_COLUMNS=200
MAX_RESULT_ROWS=1000
MAX_RESULT_BYTES=5242880
QUERY_TIMEOUT_MS=15000
MAX_SQL_CORRECTIONS=3
PREVIEW_TTL_SECONDS=900
NODE_ENV="development"
